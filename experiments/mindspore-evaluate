#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -n "${SMART_TEXTBOOK_AGENT_PREFIX:-}" ]]; then
  PREFIX="$SMART_TEXTBOOK_AGENT_PREFIX"
else
  PREFIX=""
  candidate="$SCRIPT_DIR"
  for _ in 1 2 3 4 5 6; do
    if [[ -f "$candidate/runtime.env" && -d "$candidate/experiments" ]]; then
      PREFIX="$candidate"
      break
    fi
    if [[ -f "$candidate/releases/current/runtime.env" ]]; then
      PREFIX="$candidate"
      break
    fi
    parent="$(dirname -- "$candidate")"
    [[ "$parent" == "$candidate" ]] && break
    candidate="$parent"
  done
  [[ -n "$PREFIX" ]] || PREFIX="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
fi
RUNTIME_ENV="$PREFIX/runtime.env"
if [[ ! -f "$RUNTIME_ENV" && -f "$PREFIX/releases/current/runtime.env" ]]; then
  RUNTIME_ENV="$PREFIX/releases/current/runtime.env"
fi
[[ -f "$RUNTIME_ENV" ]] || { echo "runtime environment is missing: $RUNTIME_ENV" >&2; exit 1; }
CANN_ENV_SCRIPT=${SMART_TEXTBOOK_AGENT_CANN_ENV_SCRIPT:-}
if [[ -z "$CANN_ENV_SCRIPT" ]]; then
  for candidate in /usr/local/Ascend/ascend-toolkit/set_env.sh /usr/local/Ascend/ascend-toolkit/latest/set_env.sh; do
    [[ ! -f "$candidate" ]] || { CANN_ENV_SCRIPT=$candidate; break; }
  done
fi
set +u
if [[ -n "$CANN_ENV_SCRIPT" && -f "$CANN_ENV_SCRIPT" ]]; then . "$CANN_ENV_SCRIPT"; fi
set -u
# The selected release exports its CANN/Python/data paths for system Python.
set -a
. "$RUNTIME_ENV"
set +a
ulimit -l unlimited || true
cd "${SMART_TEXTBOOK_AGENT_STUDENT_HOME:-/home/student}/lab_reference_mindspore"
HELPER="${SMART_TEXTBOOK_RUNTIME_HELPERS_ROOT:-/usr/local/share/reference-labs}/train-lenet.py"
[[ -f "$HELPER" ]] || { echo "reference experiment helper is missing" >&2; exit 1; }
exec /usr/bin/python3 "$HELPER" --action evaluate --limit 256 --data "${SMART_TEXTBOOK_DATASET_ROOT:-/var/lib/smart-textbook/mindspore/mnist}"
