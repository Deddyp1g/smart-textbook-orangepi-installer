#!/usr/bin/python3
"""Check whether the board's Ascend devices have an active client."""

import os
from pathlib import Path
import stat


REQUIRED_NODES = ("davinci0", "davinci_manager_docker", "svm0")
OPTIONAL_NODES = ("davinci_manager", "devmm_svm", "ts_aisle")
VENDOR_TOOLS = (
    Path("/usr/bin/npu-smi"),
    Path("/usr/local/sbin/npu-smi"),
    Path("/usr/local/bin/npu-smi"),
)
DRIVER_CGROUP = "/system.slice/start-davinci.service"
MONITOR_COMMANDS = {
    (b"info",),
    (b"info", b"-l"),
    (b"info", b"-t", b"health", b"-i", b"0"),
    (b"info", b"-t", b"usages", b"-i", b"0"),
}
MONITOR_MAX_AGE = 20
UNAVAILABLE = 1
OCCUPIED = 10


def device_numbers(dev):
    devices = set()
    for name in (*REQUIRED_NODES, *OPTIONAL_NODES):
        try:
            info = (dev / name).stat()
        except FileNotFoundError:
            if name in REQUIRED_NODES:
                raise
            continue
        if not stat.S_ISCHR(info.st_mode):
            raise ValueError("not an Ascend character device")
        devices.add(info.st_rdev)
    return devices


def identity(info):
    return info.st_dev, info.st_ino


def monitor_identities(paths):
    trusted = set()
    for path in paths:
        try:
            info = path.stat()
        except FileNotFoundError:
            continue
        if stat.S_ISREG(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022:
            trusted.add(identity(info))
    return trusted


def vendor_monitor(pid, monitors, proc):
    if not monitors or identity((pid / "exe").stat()) not in monitors:
        return False
    uid_line = next((line for line in (pid / "status").read_text().splitlines()
                     if line.startswith("Uid:")), "")
    if uid_line.split()[1:] != ["0", "0", "0", "0"]:
        return False
    arguments = (pid / "cmdline").read_bytes().rstrip(b"\0").split(b"\0")
    if tuple(arguments[1:]) not in MONITOR_COMMANDS:
        return False
    # /proc/PID/stat starts with "pid (comm)". The comm may contain spaces.
    fields = (pid / "stat").read_text().rsplit(")", 1)[1].split()
    started_at = int(fields[19]) / os.sysconf("SC_CLK_TCK")
    uptime = float((proc / "uptime").read_text().split()[0])
    return 0 <= uptime - started_at <= MONITOR_MAX_AGE


def driver_process(pid):
    for line in (pid / "cgroup").read_text().splitlines():
        _hierarchy, controllers, path = line.split(":", 2)
        if controllers in {"", "name=systemd"} and (
            path == DRIVER_CGROUP or path.startswith(DRIVER_CGROUP + "/")
        ):
            return True
    return False


def holds_device(fd, devices):
    try:
        info = fd.stat()
    except (FileNotFoundError, ProcessLookupError):
        return False
    return stat.S_ISCHR(info.st_mode) and info.st_rdev in devices


def probe(proc=Path("/proc"), dev=Path("/dev"), vendor_tools=VENDOR_TOOLS):
    try:
        devices = device_numbers(dev)
        monitors = monitor_identities(vendor_tools)
        pids = [path for path in proc.iterdir() if path.name.isdecimal()]
    except (OSError, ValueError):
        return UNAVAILABLE

    incomplete = False
    for pid in pids:
        try:
            with os.scandir(pid / "fd") as descriptors:
                for fd in descriptors:
                    if not holds_device(fd, devices):
                        continue
                    try:
                        if driver_process(pid) or vendor_monitor(pid, monitors, proc):
                            break
                    except (FileNotFoundError, ProcessLookupError):
                        if not holds_device(fd, devices):
                            continue
                    return OCCUPIED
        except (FileNotFoundError, ProcessLookupError):
            continue
        except (OSError, ValueError, IndexError):
            incomplete = True
    return UNAVAILABLE if incomplete else 0


if __name__ == "__main__":
    raise SystemExit(probe() if os.geteuid() == 0 else UNAVAILABLE)
