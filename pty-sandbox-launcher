#!/bin/sh
set -eu
GENERATION=
WORKSPACE=/home/student
while [ "$#" -gt 0 ]; do
  case "$1" in
    --generation) [ "$#" -ge 2 ] || exit 64; GENERATION=$2; shift 2 ;;
    --workspace) [ "$#" -ge 2 ] || exit 64; WORKSPACE=$2; shift 2 ;;
    *) exit 64 ;;
  esac
done
case "$GENERATION" in ""|*[!A-Za-z0-9._-]*) exit 64 ;; esac
case "$WORKSPACE" in
  /home/student|/home/student/lab_reference_mindspore) ;;
  /home/student/lab_assignment_[1-9]*)
    ASSIGNMENT_ID=${WORKSPACE#/home/student/lab_assignment_}
    case "$ASSIGNMENT_ID" in ""|*[!0-9]*) exit 64 ;; esac
    [ "${#ASSIGNMENT_ID}" -le 10 ] || exit 64
    [ "$ASSIGNMENT_ID" -le 2147483647 ] 2>/dev/null || exit 64
    ;;
  *) exit 64 ;;
esac
if ! id student >/dev/null 2>&1; then echo 'student sandbox account is required' >&2; exit 78; fi
BASE=/var/lib/smart-textbook/workspaces
TARGET="$BASE/$GENERATION"
mkdir -p "$TARGET" "$WORKSPACE"
chown -R student:student "$TARGET" "$WORKSPACE" 2>/dev/null || true
chmod 0700 "$TARGET" "$WORKSPACE"
PREFIX=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# env -i deliberately removes control-plane credentials. Load only the public,
# signed runtime environment after dropping privileges to student.
SANDBOX_SHELL='
set -e
# Load the host CANN/Ascend ABI first; the signed release then contributes
# Python, data, and helper paths without hiding the host toolkit libraries.
for candidate in /usr/local/Ascend/ascend-toolkit/set_env.sh /usr/local/Ascend/ascend-toolkit/latest/set_env.sh; do
  if [ -r "$candidate" ]; then source "$candidate"; break; fi
done
if [ -r "$SMART_TEXTBOOK_PTY_PREFIX/releases/current/runtime.env" ]; then
  source "$SMART_TEXTBOOK_PTY_PREFIX/releases/current/runtime.env"
fi
if [ -n "${ASCEND_HOME_PATH:-}" ]; then
  if [ -d "$ASCEND_HOME_PATH/include" ]; then export NPU_HOST_INC="$ASCEND_HOME_PATH/include"; else export NPU_HOST_INC="$ASCEND_HOME_PATH/runtime/include"; fi
  export NPU_HOST_LIB="$ASCEND_HOME_PATH/lib64"
fi
cd "$SMART_TEXTBOOK_WORKSPACE"
exec /bin/bash --noprofile --norc
'
set -- env -i HOME=/home/student USER=student LOGNAME=student PATH=/usr/local/bin:/usr/bin:/bin PWD="$WORKSPACE" SMART_TEXTBOOK_WORKSPACE="$WORKSPACE" SMART_TEXTBOOK_PTY_PREFIX="$PREFIX" /bin/bash --noprofile --norc -c "$SANDBOX_SHELL"
if command -v setpriv >/dev/null 2>&1; then
  # Keep the host memlock limit; ACL device setup can fail at the default 64 KiB.
  if command -v prlimit >/dev/null 2>&1; then
    exec prlimit --memlock=unlimited:unlimited -- setpriv --reuid=student --regid=student --init-groups "$@"
  fi
  exec setpriv --reuid=student --regid=student --init-groups "$@"
fi
if command -v runuser >/dev/null 2>&1; then
  exec runuser -u student -- "$@"
fi
echo 'setpriv or runuser is required for the student sandbox' >&2
exit 78
