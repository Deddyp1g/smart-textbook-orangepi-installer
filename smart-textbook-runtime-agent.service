[Unit]
Description=Smart Textbook Orange Pi runtime agent
Wants=network-online.target
After=network-online.target time-sync.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/smart-textbook/runtime-agent.env
ExecStart=/opt/smart-textbook/runtime-agent/start-agent.sh
Restart=always
RestartSec=3
UMask=0077
LimitMEMLOCK=infinity
# Ascend ACL requires shared host IPC/tmp and device access; protocol RPCs remain allow-listed.
NoNewPrivileges=false
PrivateTmp=false
ProtectHome=false
ProtectSystem=off
DevicePolicy=auto
ReadWritePaths=/var/lib/smart-textbook /etc/smart-textbook /home/student

[Install]
WantedBy=multi-user.target
