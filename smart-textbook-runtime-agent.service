[Unit]
Description=Smart Textbook Orange Pi runtime agent
Wants=network-online.target docker.service
After=network-online.target time-sync.target docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/smart-textbook/runtime-agent.env
ExecStart=/opt/smart-textbook/runtime-agent/start-agent.sh
Restart=always
RestartSec=10
WatchdogSec=180
WatchdogSignal=SIGKILL
NotifyAccess=main
TimeoutStopSec=20
UMask=0077
LimitMEMLOCK=infinity
# Ascend ACL requires shared host IPC/tmp and device access; protocol RPCs remain allow-listed.
NoNewPrivileges=false
PrivateTmp=false
ProtectHome=false
ProtectSystem=off
DevicePolicy=auto
ReadWritePaths=/var/lib/smart-textbook /etc/smart-textbook /home/student

[Install]
WantedBy=multi-user.target
