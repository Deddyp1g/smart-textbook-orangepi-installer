# Pairing installation writes the selected server to local runtime-agent.env.
# No public server fallback is provided; configure an http(s) origin to pair.
SMART_TEXTBOOK_AGENT_SERVER_URL=
SMART_TEXTBOOK_AGENT_VERIFY_TLS=true
SMART_TEXTBOOK_AGENT_PRIVATE_KEY=/etc/smart-textbook/runtime-agent.ed25519
SMART_TEXTBOOK_AGENT_DEVICE_ID=
SMART_TEXTBOOK_AGENT_HEARTBEAT_SECONDS=10
SMART_TEXTBOOK_AGENT_ARTIFACT_SERVER_URL=
SMART_TEXTBOOK_AGENT_ARTIFACT_TOKEN=
SMART_TEXTBOOK_AGENT_ARTIFACT_ROOT=/opt/smart-textbook/runtime-agent/releases
SMART_TEXTBOOK_AGENT_ARTIFACT_SYNC=true
SMART_TEXTBOOK_AGENT_LOG_LEVEL=INFO

# Server-only bootstrap token; never copy this to Orange Pi runtime-agent.env
RUNTIME_AGENT_ENROLLMENT_TOKEN=
